# Copy to .env and fill in
STRAVA_ACCESS_TOKEN=your_strava_access_token_here
STRAVA_REFRESH_TOKEN=your_refresh_token_here
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here
# EXPIRES_AT is the unix timestamp when the access token expires (seconds since epoch)
EXPIRES_AT=0
# OAuth callback URL
STRAVA_CALLBACK_URL=http://localhost:5173/auth/callback
# JWT secret for signing authentication tokens
JWT_SECRET=your_jwt_secret_here_generate_a_random_string
PORT=4000

